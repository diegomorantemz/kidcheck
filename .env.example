# Copia este archivo como .env y ajusta los valores para tu entorno.

# Puertos publicados en el host (útiles si ya tienes algo en 8080/5173)
API_PORT=8080
WEB_PORT=5173
DB_PORT=3306
DB_PASSWORD=root

# API
JWT_SECRET=cambia-este-secreto-de-al-menos-32-bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
WEB_PUBLIC_URL=http://localhost:5173

# Jobs de negocio (RN-01 inasistencias cada 5 min, RN-03 reincidencias los viernes)
KIDCHECK_JOBS_ENABLED=true

# WhatsApp (Twilio Sandbox en la demo). Si TWILIO_ENABLED=false se simula el envío.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Panel
WEB_ORIGIN=http://localhost:5173
